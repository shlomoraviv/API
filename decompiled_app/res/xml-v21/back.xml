<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:key="back_screen"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/back_button" android:key="pref_cat_back">
        <SwitchPreference android:title="@string/customize" android:key="pref_back_enabled" />
        <flar2.homebutton.adapters.AppPickerPref android:title="@string/single_tap" android:key="pref_back_single_tap" />
        <flar2.homebutton.adapters.AppPickerPref android:title="@string/double_tap" android:key="pref_back_double_tap" />
        <flar2.homebutton.adapters.AppPickerPref android:title="@string/long_press" android:key="pref_back_long_press" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/options" android:key="pref_cat_back_options">
        <flar2.homebutton.utils.SeekBarPreference android:max="100" android:key="pref_back_vibrate" android:defaultValue="0" />
    </PreferenceCategory>
</PreferenceScreen>
