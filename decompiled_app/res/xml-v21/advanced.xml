<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:key="advanced_options"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/button_options" android:key="pref_cat_advanced_button">
        <ListPreference android:entries="@array/lp_delay_entries" android:title="@string/long_press_delay" android:key="pref_longpress_delay" android:summary="%s" android:defaultValue="500" android:entryValues="@array/delay_values" />
        <ListPreference android:entries="@array/dt_delay_entries" android:title="@string/double_tap_delay" android:key="pref_doubletap_delay" android:summary="%s" android:defaultValue="500" android:entryValues="@array/delay_values" />
        <SwitchPreference android:title="@string/double_tap_wait" android:key="pref_doubletap_wait" android:summary="@string/double_tap_wait_summary" android:defaultValue="false" />
        <SwitchPreference android:title="@string/alt_input" android:key="pref_alt_input" android:summary="@string/alt_input_msg" android:defaultValue="false" />
        <SwitchPreference android:title="@string/alt_buttonmethod" android:key="pref_alt_buttonmethod" android:summary="@string/alt_buttonmethod_msg" android:defaultValue="false" />
        <SwitchPreference android:title="@string/alt_home" android:key="pref_alt_home" android:summary="@string/alt_home_msg" android:defaultValue="false" />
        <SwitchPreference android:title="@string/shortcuts_immediately" android:key="pref_shortcut_immediate" android:summary="@string/shortcuts_immediately_summary" android:defaultValue="false" />
        <SwitchPreference android:title="@string/simulate_keycodes" android:key="pref_simulate_keycodes" android:summary="@string/simulate_keycodes_summary" android:defaultValue="false" />
        <SwitchPreference android:title="@string/alt_blackberry" android:key="pref_alt_blackberry" android:summary="@string/alt_blackberry_summary" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/bypass_options" android:key="pref_cat_advanced">
        <SwitchPreference android:title="@string/bypass_bb_keyboard" android:key="pref_bb_keyboard_bypass" android:summary="@string/bypass_bb_keyboard_msg" android:defaultValue="false" />
        <SwitchPreference android:title="@string/bypass_system" android:key="pref_system_bypass" android:summary="@string/bypass_system_msg" android:defaultValue="true" />
        <SwitchPreference android:title="@string/bypass_camera" android:key="pref_camera_bypass" android:summary="@string/bypass_camera_msg" android:defaultValue="true" />
        <SwitchPreference android:title="@string/bypass_clock" android:key="pref_clock_bypass" android:summary="@string/bypass_clock_msg" android:defaultValue="true" />
        <SwitchPreference android:title="@string/bypass_phone" android:key="pref_phone_bypass" android:summary="@string/bypass_phone_msg" android:defaultValue="true" />
        <SwitchPreference android:title="@string/volume_bypass" android:key="pref_vol_bypass_enabled" android:summary="@string/volume_bypass_msg" android:defaultValue="true" />
        <SwitchPreference android:title="@string/bypass_lockscreen" android:key="pref_lockscreen_bypass" android:summary="@string/bypass_lockscreen_msg" android:defaultValue="false" />
        <Preference android:title="@string/bypass_apps" android:key="pref_apps_bypass" android:summary="@string/bypass_apps_msg">
            <intent android:targetPackage="flar2.homebutton" android:targetClass="a.z" />
        </Preference>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/experimental_options" android:key="pref_cat_advanced_experimental">
        <ListPreference android:entries="@array/flashlight_timeout_entries" android:title="@string/flashlight_timeout" android:key="pref_flashlight_timeout" android:summary="%s" android:defaultValue="300000" android:entryValues="@array/flashlight_timeout_values" />
        <SwitchPreference android:title="@string/brighter_flashlight" android:key="pref_flashlight_brighter" android:defaultValue="false" />
        <SwitchPreference android:title="@string/screenshot_sound" android:key="pref_screenshot_sound" android:defaultValue="false" />
        <SwitchPreference android:title="@string/dnd_disable" android:key="pref_dnd_disable" android:summary="@string/dnd_disable_summary" android:defaultValue="false" />
        <SwitchPreference android:title="@string/bixby_disable_accessibility" android:key="pref_bixby_accessibility" android:summary="@string/bixby_disable_accessibility_msg" android:defaultValue="false" />
        <SwitchPreference android:title="@string/show_notification" android:key="pref_show_notification" android:defaultValue="false" />
        <SwitchPreference android:title="@string/notification_priority" android:key="pref_notification_priority" android:defaultValue="false" />
        <SwitchPreference android:title="@string/alt_lock_method" android:key="pref_alt_lock" android:summary="@string/al_lock_method_summary" android:defaultValue="false" />
        <SwitchPreference android:title="@string/alt_assistant" android:key="pref_alt_assistant" android:summary="@string/alt_assistant_summary" android:defaultValue="false" />
        <SwitchPreference android:title="@string/headset_audio" android:key="pref_headset_detect" android:summary="@string/headset_audio_summary" />
    </PreferenceCategory>
</PreferenceScreen>
