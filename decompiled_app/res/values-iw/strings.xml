    <string name="APKTOOL_RENAMED_0x7f110050">אנא הפעל את \"ניפוי באגים אלחוטי\" ב\"אפשרויות מפתח\". \"ניפוי באגים אלחוטי\" מושבת אוטומטית כאשר הרשת משתנה.\n\nשים לב, אין להשבית את \"אפשרויות מפתח\" או \"ניפוי באגים ב-USB\", אחרת Shizuku ייעצר.</string>
    <string name="APKTOOL_RENAMED_0x7f110051">אנא נסה להשבית ולהפעיל את \"ניפוי באגים אלחוטי\" אם החיפוש נמשך.</string>
    <string name="APKTOOL_RENAMED_0x7f110052">הפורט הוא מספר שלם בטווח שבין 1 ל-65535.</string>
    <string name="APKTOOL_RENAMED_0x7f110053">מחפש שירות צימוד</string>
    <string name="APKTOOL_RENAMED_0x7f110054">אנא התחל בצימוד לפי השלבים הבאים: \"אפשרויות מפתח\" - \"ניפוי באגים אלחוטי\" - \"צימוד מכשיר באמצעות קוד צימוד\".\n\nלאחר שתהליך הצימוד יתחיל, תוכל להזין את קוד הצימוד.</string>
