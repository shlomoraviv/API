    <string name="APKTOOL_RENAMED_0x7f110126">ייצוא קבצים</string>
    <string name="APKTOOL_RENAMED_0x7f110127">תחילה, ייצא קבצים לכל מקום שתרצה. תמצא שני קבצים, %1$s ו-%2$s.</string>
    <string name="APKTOOL_RENAMED_0x7f110128">אם ישנם קבצים בעלי אותו שם בתיקייה שנבחרה, הם יימחקו.\n\nפונקציית הייצוא משתמשת ב-SAF (מסגרת גישה לאחסון). דווח כי MIUI פוגעת בתפקוד של SAF. אם אתה משתמש ב-MIUI, ייתכן שתצטרך לחלץ את הקובץ מתוך ה-APK של Shizuku או להוריד אותו מ-GitHub.</string>
    <string name="APKTOOL_RENAMED_0x7f110129">לאחר מכן, השתמש בעורך טקסט כלשהו כדי לפתוח ולערוך את %1$s.</string>
    <string name="APKTOOL_RENAMED_0x7f11012a">לדוגמה, אם ברצונך להשתמש ב-Shizuku ב-%1$s, עליך להחליף את %2$s ב-%3$s (%4$s הוא שם החבילה של %1$s).</string>
    <string name="APKTOOL_RENAMED_0x7f11012b">לבסוף, העבר את הקבצים למקום שבו לאפליקציית המסוף שלך יש גישה אליו, ותוכל להשתמש ב-%1$s כדי להריץ פקודות דרך Shizuku.</string>
    <string name="APKTOOL_RENAMED_0x7f11012c">כמה טיפים: הענק הרשאת הפעלה ל-%1$s והוסף אותו ל-%2$s, ותוכל להשתמש ב-%1$s ישירות.</string>
