    <string name="APKTOOL_RENAMED_0x7f11001e">לא ניתן להפיק מפתח עבור ניפוי באגים אלחוטי.\nייתכן שזה נובע מכך שמנגנון ה-KeyStore של מכשיר זה אינו תקין.</string>
    <string name="APKTOOL_RENAMED_0x7f11001f">אנא בצע את שלב הצימוד תחילה.</string>
    <string name="APKTOOL_RENAMED_0x7f110020">צימוד</string>
    <string name="APKTOOL_RENAMED_0x7f110021">אנא היכנס למצב מסך מפוצל (ריבוי חלונות) תחילה.</string>
    <string name="APKTOOL_RENAMED_0x7f110022">המערכת דורשת שתיבת הדו-שיח של הצימוד תהיה גלויה תמיד. שימוש במצב מסך מפוצל הוא הדרך היחידה לאפשר לאפליקציה זו ולתיבת הדו-שיח של המערכת להיות גלויות בו-זמנית.</string>
    <string name="APKTOOL_RENAMED_0x7f110023">הזן את הקוד שבהתראה כדי להשלים את הצימוד.</string>
    <string name="APKTOOL_RENAMED_0x7f110024">חזור אל Shizuku והפעל את Shizuku.</string>
    <string name="APKTOOL_RENAMED_0x7f110025">שים לב, החלק השמאלי של האפשרות \"ניפוי באגים אלחוטי\" לחיץ, והקשה עליו תפתח דף חדש. הפעלת המתג בצד ימין בלבד אינה מספיקה.</string>
    <string name="APKTOOL_RENAMED_0x7f110026">ייתכן שמשתמשי MIUI יצטרכו לשנות את סגנון ההתראות ל-\"Android\" מתוך \"התראות\" - \"וילון התראות\" בהגדרות המערכת.</string>
    <string name="APKTOOL_RENAMED_0x7f110027">אחרת, ייתכן שלא תוכל להזין את קוד הצימוד מההתראה.</string>
    <string name="APKTOOL_RENAMED_0x7f110028">Shizuku צריך לגשת לרשת המקומית. הדבר נשלט על ידי הרשאת הרשת.</string>
    <string name="APKTOOL_RENAMED_0x7f110029">מערכות מסוימות (כמו MIUI) אינן מאפשרות לאפליקציות לגשת לרשת כשהן אינן גלויות, גם אם האפליקציה משתמשת בשירות קדמה כסטנדרט. אנא השבת את תכונות אופטימיזציית הסוללה עבור Shizuku במערכות כאלה.</string>
    <string name="APKTOOL_RENAMED_0x7f11002a">התראה מ-Shizuku תסייע לך להשלים את הצימוד.</string>
    <string name="APKTOOL_RENAMED_0x7f11002b">תהליך הצימוד דורש ממך לקיים אינטראקציה עם התראה מ-Shizuku. אנא אפשר ל-Shizuku לשלוח התראות.</string>
    <string name="APKTOOL_RENAMED_0x7f11002c">היכנס אל \"אפשרויות מפתח\" - \"ניפוי באגים אלחוטי\". הקש על \"צימוד מכשיר באמצעות קוד צימוד\", ותראה קוד בן שש ספרות.</string>
    <string name="APKTOOL_RENAMED_0x7f11002d">צמד את Shizuku למכשיר שלך</string>
