<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/screenshot_background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:color/black" />
    <ImageView android:layout_gravity="center" android:id="@id/screenshot" android:background="@drawable/screenshot_panel" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" />
