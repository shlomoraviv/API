<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#080b41" android:endColor="#09466e" android:angle="45.0" android:centerY="0.1" android:centerColor="#081b43" />
            <corners android:radius="10.0dp" />
            <stroke android:width="2.0dp" android:color="#ffffff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#040630" android:endColor="#003558" android:angle="45.0" android:centerY="0.1" android:centerColor="#051639" />
            <corners android:radius="10.0dp" />
            <stroke android:width="2.0dp" android:color="#ffffff" />
        </shape>
    </item>
</selector>
