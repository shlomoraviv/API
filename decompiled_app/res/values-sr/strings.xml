    <string name="APKTOOL_RENAMED_0x7f11001e">"Neuspešno generisanje ključa za bežično otklanjanje grešaka. 
Ovo je možda iz razloga što je mehanizam skladišta ključeva ovog uređaja neispravan."</string>
    <string name="APKTOOL_RENAMED_0x7f11001f">Molim Vas, najpre prođite kroz korake za uparivanje uređaja.</string>
    <string name="APKTOOL_RENAMED_0x7f110021">Molim Vas, najpre izaberite režim podeljenog ekrana, odnosno režim više prozora.</string>
