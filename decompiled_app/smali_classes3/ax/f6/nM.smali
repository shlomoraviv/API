.class public final Lax/f6/nM;
.super Lax/f6/vH;


# direct methods
.method public constructor <init>(Lax/f6/fI;)V
    .locals 1

    const/4 v0, 0x0

    invoke-direct {p0, p1, v0}, Lax/f6/vH;-><init>(Lax/f6/fI;Lax/f6/Ut;)V

    return-void
.end method

.method public constructor <init>(Lax/f6/fI;Lax/f6/Ut;)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lax/f6/vH;-><init>(Lax/f6/fI;Lax/f6/Ut;)V

    return-void
.end method
